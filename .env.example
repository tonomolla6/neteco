# Runtime. Production validates every required value and fails closed.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
# Keep equal to APP_BASE_URL. Required at container runtime for canonicals, sitemaps and browser-facing URLs.
NUXT_PUBLIC_BASE_URL=http://localhost:3000
APP_VERSION=dev
PRICE_DISPLAY_MODE=gross
DATABASE_URL=postgres://neteco:neteco-local@localhost:56432/neteco
REDIS_URL=redis://localhost:56379/0
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
AUTH_TOKEN_PEPPER=replace-with-a-long-independent-random-secret
AUTH_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output

# Versioned documents. Production requires an actual legal review date and HTTPS URLs.
LEGAL_TERMS_VERSION=purchase-2026-08-12
LEGAL_PRIVACY_VERSION=privacy-2026-08-12
LEGAL_REVIEWED_AT=
LEGAL_TERMS_URL=https://neteco.es/legal
PRIVACY_URL=https://neteco.es/legal
COOKIES_URL=https://neteco.es/cookies

# Durable mounted/object-backed media path and mandatory production malware scanner.
MEDIA_STORAGE_DIRECTORY=.data/media
MEDIA_MAX_BYTES=15000000
CLAMAV_HOST=
CLAMAV_PORT=3310

# Providers are mock by default outside production.
PAYMENT_PROVIDER=mock
INVOICE_PROVIDER=mock
CARRIER_PROVIDER=mock
EMAIL_PROVIDER=log

# Disabled until Finance approves the account and reconciliation procedure.
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BENEFICIARY=

# Commercial shipping policy. Production values require business/carrier approval.
FREE_SHIPPING_THRESHOLD_CENTS=15000
OWN_DELIVERY_POSTAL_PREFIXES=468
# Europe/Madrid business calendar. Comma-separated ISO dates; carrier-specific dates are additive.
SHIPPING_CUTOFF_LOCAL_HOUR=13
SHIPPING_NATIONAL_HOLIDAYS=
SHIPPING_LOCAL_HOLIDAYS=
SHIPPING_CARRIER_HOLIDAYS=

# Redsys Redirect (sandbox values only in local/staging; never commit real values).
REDSYS_ENV=sandbox
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_CURRENCY=978
REDSYS_MERCHANT_NAME=NETECO

# Beply API v3.
BEPLY_BASE_URL=https://api.beply.es/v3
BEPLY_API_TOKEN=
BEPLY_INVOICE_SERIES=
BEPLY_CORRECTIVE_SERIES=
BEPLY_TAX_CODE_0=
BEPLY_TAX_CODE_10=
BEPLY_TAX_CODE_21=
BEPLY_PAYMENT_CODE_REDSYS=
BEPLY_PAYMENT_CODE_BANK_TRANSFER=
BEPLY_COMPANY_ID=

# Transactional email. Marketing must use separate credentials/domain.
EMAIL_FROM=pedidos@neteco.es
EMAIL_REPLY_TO=hola@neteco.es
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Required with SMTP outside production; comma-separated exact hosts and recipients (`*@example.invalid` allowed).
SMTP_ALLOWED_HOSTS=localhost,127.0.0.1
EMAIL_ALLOWED_RECIPIENTS=*@example.invalid,*@integration.invalid
EMAIL_API_URL=
EMAIL_API_TOKEN=

# Marketing email is deliberately fail-closed and cannot reuse transactional credentials in production.
MARKETING_EMAIL_PROVIDER=log
MARKETING_EMAIL_FROM=newsletter@neteco.es
MARKETING_SMTP_HOST=localhost
MARKETING_SMTP_PORT=51025
MARKETING_SMTP_SECURE=false
MARKETING_SMTP_USER=
MARKETING_SMTP_PASSWORD=
MARKETING_SMTP_ALLOWED_HOSTS=localhost,127.0.0.1
MARKETING_EMAIL_ALLOWED_RECIPIENTS=*@example.invalid,*@integration.invalid

# Observability; telemetry is disabled when these are empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_TRACKING_DSN=

# Commercial terms shown to customers (shared/commercial-terms.ts). Empty values are never
# turned into promises; empty phones are not shown. Contact email defaults to tienda@neteco.es.
COMMERCIAL_CONTACT_EMAIL=
COMMERCIAL_CONTACT_PHONE=
COMMERCIAL_SUPPORT_PHONE_AI=
COMMERCIAL_SUPPORT_HOURS=
COMMERCIAL_OWN_DELIVERY_DAYS=
COMMERCIAL_ORDER_CUTOFF_TIME=
COMMERCIAL_OWN_DELIVERY_COST_CENTS=
COMMERCIAL_OWN_DELIVERY_FREE_FROM_CENTS=
COMMERCIAL_OWN_DELIVERY_MINIMUM_ORDER_CENTS=
COMMERCIAL_PARCEL_LEAD_TIME=
COMMERCIAL_PARCEL_COST_CENTS=
COMMERCIAL_DEFERRED_PAYMENT_DAYS=
COMMERCIAL_DEFERRED_PAYMENT_CONDITIONS=
COMMERCIAL_WHATSAPP_NUMBER=
COMMERCIAL_FOUNDED_YEAR=
COMMERCIAL_ECO_RANGE_BRAND=
COMMERCIAL_COMPANY_TAX_ID=
COMMERCIAL_COMPANY_ADDRESS=
COMMERCIAL_CERTIFICATIONS_PUBLISHED=

# External floating chat (shared/chat-widget.ts). Empty: nothing is loaded. With cookies
# (default) it loads only after marketing consent. Its https origins must be listed in
# CSP_CHAT_WIDGET_ORIGINS (comma-separated) both here and in the shop Worker environment.
COMMERCIAL_CHAT_WIDGET_SRC=
COMMERCIAL_CHAT_WIDGET_ID=
COMMERCIAL_CHAT_WIDGET_COOKIES=
CSP_CHAT_WIDGET_ORIGINS=
