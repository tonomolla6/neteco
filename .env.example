# Runtime. Production validates every required value and fails closed.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
APP_VERSION=dev
PRICE_DISPLAY_MODE=gross
DATABASE_URL=postgres://neteco:neteco-local@localhost:56432/neteco
REDIS_URL=redis://localhost:56379/0
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
AUTH_TOKEN_PEPPER=replace-with-a-long-independent-random-secret
AUTH_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output

# Versioned documents. Production requires an actual legal review date and HTTPS URLs.
LEGAL_TERMS_VERSION=purchase-2026-08-12
LEGAL_PRIVACY_VERSION=privacy-2026-08-12
LEGAL_REVIEWED_AT=
LEGAL_TERMS_URL=https://neteco.es/legal
PRIVACY_URL=https://neteco.es/legal
COOKIES_URL=https://neteco.es/cookies

# Durable mounted/object-backed media path and mandatory production malware scanner.
MEDIA_STORAGE_DIRECTORY=.data/media
MEDIA_MAX_BYTES=15000000
CLAMAV_HOST=
CLAMAV_PORT=3310

# Providers are mock by default outside production.
PAYMENT_PROVIDER=mock
INVOICE_PROVIDER=mock
CARRIER_PROVIDER=mock
EMAIL_PROVIDER=log

# Disabled until Finance approves the account and reconciliation procedure.
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BENEFICIARY=

# Commercial shipping policy. Production values require business/carrier approval.
FREE_SHIPPING_THRESHOLD_CENTS=15000
OWN_DELIVERY_POSTAL_PREFIXES=468

# Redsys Redirect (sandbox values only in local/staging; never commit real values).
REDSYS_ENV=sandbox
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_CURRENCY=978
REDSYS_MERCHANT_NAME=NETECO

# Beply API v3.
BEPLY_BASE_URL=https://api.beply.es/v3
BEPLY_API_TOKEN=
BEPLY_INVOICE_SERIES=
BEPLY_CORRECTIVE_SERIES=
BEPLY_TAX_CODE_0=
BEPLY_TAX_CODE_10=
BEPLY_TAX_CODE_21=
BEPLY_PAYMENT_CODE_REDSYS=
BEPLY_PAYMENT_CODE_BANK_TRANSFER=
BEPLY_COMPANY_ID=

# Transactional email. Marketing must use separate credentials/domain.
EMAIL_FROM=pedidos@neteco.es
EMAIL_REPLY_TO=hola@neteco.es
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_API_URL=
EMAIL_API_TOKEN=

# Marketing email is deliberately fail-closed and cannot reuse transactional credentials in production.
MARKETING_EMAIL_PROVIDER=log
MARKETING_EMAIL_FROM=newsletter@neteco.es
MARKETING_SMTP_HOST=localhost
MARKETING_SMTP_PORT=51025
MARKETING_SMTP_SECURE=false
MARKETING_SMTP_USER=
MARKETING_SMTP_PASSWORD=

# Observability; telemetry is disabled when these are empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_TRACKING_DSN=
