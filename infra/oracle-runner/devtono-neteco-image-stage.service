[Unit]
Description=Neteco operator-only immutable OCI image staging (no CI jobs)
After=devtono-neteco-network.service devtono-neteco-egress.service
Requires=devtono-neteco-network.service devtono-neteco-egress.service
BindsTo=devtono-neteco-network.service devtono-neteco-egress.service
JoinsNamespaceOf=devtono-neteco-network.service
RequiresMountsFor=/var/lib/neteco-ci-runtime
ConditionPathIsMountPoint=/var/lib/neteco-ci-runtime

[Service]
Type=oneshot
User=980
Group=979
WorkingDirectory=/var/lib/neteco-ci-runtime/stage
ExecStart=/usr/bin/bash /usr/local/libexec/neteco-ci/image-stage.sh
UnsetEnvironment=BASH_ENV ENV CDPATH LD_PRELOAD LD_LIBRARY_PATH DOCKER_HOST DOCKER_CONTEXT SSH_AUTH_SOCK GITHUB_TOKEN GH_TOKEN CLOUDFLARE_API_TOKEN
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
KeyringMode=private
RemoveIPC=yes
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/neteco-ci-runtime/stage
ReadOnlyPaths=/usr/local/libexec/neteco-ci
BindReadOnlyPaths=/etc/neteco-ci/resolv.conf:/etc/resolv.conf
TemporaryFileSystem=/run:ro /tmp:ro /var/tmp:ro
InaccessiblePaths=-/root -/home -/var/lib/neteco-ci -/var/lib/neteco-ci-host -/var/lib/docker -/var/lib/containers -/var/lib/sabea-actions-runner -/var/oled/devtono-ci/notifestival -/etc/devtono -/etc/finko -/usr/bin/sudo -/usr/bin/docker -/usr/bin/podman -/usr/bin/nerdctl -/usr/bin/ctr -/usr/local/bin -/usr/local/sbin
CPUQuota=100%
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=128M
TasksMax=128
IOWeight=10
Nice=10
TimeoutStartSec=15min
Restart=no
KillMode=control-group
TimeoutStopSec=30
LimitCORE=0
StandardOutput=journal
StandardError=journal
