{
  "name": "neteco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "scripts": {
    "storage:preflight": "node scripts/storage-preflight.ts",
    "prebuild": "npm run storage:preflight",
    "prebuild:cloudflare-ui": "npm run storage:preflight",
    "prebuild:worker-shop": "npm run storage:preflight",
    "prebuild:worker-canary": "npm run storage:preflight",
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "build:worker-canary": "wrangler deploy --config wrangler.canary.jsonc --dry-run --outdir .wrangler/canary --metafile .wrangler/canary-meta.json",
    "build:cloudflare-ui": "NETECO_RUNTIME=cloudflare nuxt build",
    "cloudflare:shop:config": "tsx scripts/generate-shop-config.ts",
    "build:worker-shop": "npm run cloudflare:shop:config && wrangler deploy --config .wrangler/shop/wrangler.json --dry-run --outdir ../shop-bundle --metafile .wrangler/shop-meta.json",
    "audit:shop-bundle": "tsx scripts/audit-shop-bundle.ts",
    "artifacts:cloudflare:emit": "tsx scripts/emit-cloudflare-artifacts.ts --root=. --output=.wrangler/shop-evidence",
    "artifacts:cloudflare:verify": "tsx scripts/emit-cloudflare-artifacts.ts --root=. --manifest=.wrangler/shop-evidence/manifest.json --sbom-input=.wrangler/shop-evidence/sbom.cdx.json",
    "build:shop:cloudflare": "npm run build:cloudflare-ui && npm run build:worker-shop && npm run audit:shop-bundle && npm run artifacts:cloudflare:emit && npm run artifacts:cloudflare:verify",
    "audit:shop:local": "npm run test:compiled:browser && tsx scripts/audit-cloudflare-shop.ts",
    "audit:shop:ci": "tsx scripts/run-shop-audit-ci.ts",
    "cloudflare:shop:check": "npm run build:shop:cloudflare && npm run test:compiled && npm run audit:shop:local && npm run artifacts:cloudflare:verify",
    "preview": "nuxt preview",
    "dev:worker-canary": "wrangler dev --config wrangler.canary.jsonc --local",
    "cloudflare:typegen": "wrangler types worker-configuration.d.ts --config wrangler.canary.jsonc --env-interface CloudflareEnv --strict-vars=false",
    "cloudflare:preprod:plan": "tsx scripts/cloudflare-preprod.ts",
    "cloudflare:preprod:prepare": "tsx scripts/cloudflare-preprod.ts --generate",
    "d1:migrate:canary:local": "wrangler d1 migrations apply DB --config wrangler.canary.jsonc --local",
    "d1:seed:canary:generate": "tsx scripts/generate-d1-category-seed.ts",
    "d1:seed:products:generate": "tsx scripts/generate-d1-product-seed.ts",
    "d1:seed:inventory:generate": "tsx scripts/generate-d1-inventory-seed.ts",
    "d1:seed:shipping:generate": "tsx scripts/generate-d1-shipping-seed.ts",
    "d1:seed:canary:local": "npm run d1:seed:canary:generate && npm run d1:seed:products:generate && npm run d1:seed:inventory:generate && npm run d1:seed:shipping:generate && wrangler d1 execute DB --config wrangler.canary.jsonc --local --yes --file .wrangler/generated/d1-demo-categories.sql && wrangler d1 execute DB --config wrangler.canary.jsonc --local --yes --file .wrangler/generated/d1-demo-products.sql && wrangler d1 execute DB --config wrangler.canary.jsonc --local --yes --file .wrangler/generated/d1-demo-inventory.sql && wrangler d1 execute DB --config wrangler.canary.jsonc --local --yes --file .wrangler/generated/d1-demo-shipping.sql",
    "d1:audit:canary:local": "tsx scripts/audit-d1-catalog.ts",
    "d1:audit:inventory:isolated": "tsx scripts/audit-d1-inventory.ts",
    "d1:audit:cart:isolated": "tsx scripts/audit-d1-cart.ts",
    "d1:audit:checkout:isolated": "tsx scripts/audit-d1-checkout.ts",
    "d1:audit:media:isolated": "tsx scripts/audit-d1-media.ts",
    "test:worker": "vitest run --config vitest.node.config.ts --project unit tests/unit/d1-*.test.ts tests/unit/cloudflare-*.test.ts tests/unit/worker-*.test.ts tests/unit/nuxt-cloudflare-profile.test.ts tests/unit/nitro-d1-bridge.test.ts",
    "audit:worker-bundle": "tsx scripts/audit-worker-bundle.ts .wrangler/canary-meta.json",
    "cloudflare:check": "npm run cloudflare:typegen -- --check && npm run d1:migrate:canary:local && npm run d1:seed:canary:local && npm run d1:audit:canary:local && npm run d1:audit:inventory:isolated && npm run d1:audit:cart:isolated && npm run d1:audit:checkout:isolated && npm run d1:audit:media:isolated && npm run test:worker && npm run build:worker-canary && npm run audit:worker-bundle",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:audit": "tsc --noEmit -p tsconfig.audit.json",
    "audit:catalog-import:scale": "tsx scripts/audit-native-catalog-import-scale.ts",
    "audit:catalog-file:scale": "tsx scripts/audit-catalog-file-scale.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.node.config.ts --project unit --reporter=default --reporter=junit --outputFile.junit=test-results/unit.xml",
    "test:search:relevance": "vitest run --config vitest.node.config.ts --project unit --maxWorkers=2 tests/unit/search-relevance-offline.test.ts",
    "test:compiled": "vitest run --config vitest.compiled.config.ts",
    "test:compiled:browser": "NETECO_COMPILED_BROWSER_REQUIRED=true vitest run --config vitest.compiled.config.ts",
    "test:nuxt": "vitest run --project nuxt --reporter=default --reporter=junit --outputFile.junit=test-results/nuxt.xml",
    "test:component": "vitest run --project component --reporter=default --reporter=junit --outputFile.junit=test-results/component.xml",
    "test:integration": "vitest run --project integration --reporter=default --reporter=junit --outputFile.junit=test-results/integration.xml",
    "test:recovery": "vitest run --project integration tests/integration/provider-recovery.test.ts",
    "test:chaos": "tsx scripts/run-chaos.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:browser-matrix": "tsx scripts/run-e2e.ts --config=playwright.matrix.config.ts",
    "test:visual": "tsx scripts/run-e2e.ts --config=playwright.visual.config.ts",
    "test:a11y": "tsx scripts/run-e2e.ts --config=playwright.a11y.config.ts --project=chromium --workers=2 tests/e2e/accessibility.spec.ts",
    "test:seo": "npm run test:e2e -- --project=chromium tests/e2e/seo.spec.ts",
    "test:analytics": "npm run test:e2e -- --project=chromium tests/e2e/analytics.spec.ts",
    "test:performance": "tsx scripts/run-performance.ts",
    "perf:gate": "tsx scripts/performance-gate.ts",
    "synthetic:purchase": "tsx scripts/synthetic-purchase.ts",
    "rum:backlog": "tsx scripts/rum-backlog.ts",
    "audit:a11y:manual": "tsx scripts/audit-manual-accessibility-evidence.ts",
    "audit:exploratory": "tsx scripts/audit-exploratory-evidence.ts docs/testing/exploratory-runs/2026-08-13-tst034.json",
    "audit:uat:policy": "tsx scripts/audit-operational-uat-policy.ts",
    "audit:uat": "tsx scripts/audit-operational-uat.ts",
    "uat:preflight": "tsx scripts/run-operational-uat-preflight.ts",
    "uat:inventory": "tsx scripts/operational-uat-inventory-evidence.ts",
    "test:contract:redsys:sandbox": "tsx scripts/redsys-sandbox-contract.ts",
    "test:contract:beply:sandbox": "tsx scripts/beply-sandbox-contract.ts",
    "test:determinism": "tsx scripts/audit-test-determinism.ts --publish",
    "test:flaky-policy": "tsx scripts/audit-flaky-policy.ts",
    "test:flake-monitor": "tsx scripts/run-flake-monitor.ts",
    "test:flake-browser": "tsx scripts/run-browser-flake-monitor.ts",
    "test:mutation": "stryker run && tsx scripts/audit-mutation-evidence.ts",
    "test:mutation:audit": "tsx scripts/audit-mutation-evidence.ts",
    "coverage:policy": "tsx scripts/audit-coverage-policy.ts",
    "coverage": "npm run coverage:policy && vitest run --config vitest.node.config.ts --coverage --project unit --reporter=default --reporter=junit --outputFile.junit=test-results/unit.xml && npm run coverage:policy -- --publish",
    "ci:artifacts": "tsx scripts/audit-ci-artifacts.ts",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:determinism && npm run coverage && npm run build",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "outbox:email": "tsx scripts/outbox-worker.ts",
    "outbox:invoice": "tsx scripts/invoice-worker.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "reconcile:bank-transfers": "tsx scripts/bank-transfer-reconcile.ts",
    "expire:reservations": "tsx scripts/reservation-worker.ts",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "admin:provision:d1": "tsx scripts/provision-d1-admin.ts",
    "outbox:refund": "tsx scripts/refund-worker.ts",
    "outbox:credit": "tsx scripts/credit-note-worker.ts",
    "alerts:check": "tsx scripts/operational-alerts.ts",
    "synthetic:check": "tsx scripts/synthetic-check.ts",
    "catalog:release": "tsx scripts/catalog-release.ts",
    "catalog:tabular": "tsx scripts/catalog-tabular.ts",
    "content:publish": "tsx scripts/content-publication-worker.ts",
    "requirements:audit": "tsx scripts/audit-master-requirements.ts",
    "development:plan": "tsx scripts/functional-delivery.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "^4.0.0",
    "@pinia/nuxt": "^0.11.2",
    "exceljs": "4.4.0",
    "ioredis": "6.0.0",
    "iron-webcrypto": "1.2.1",
    "nodemailer": "9.0.5",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.20",
    "otpauth": "9.5.1",
    "pinia": "^3.0.3",
    "postgres": "3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/nodemailer": "8.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.2",
    "miniflare": "5.20260815.0-alpha",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "^5.6.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "wrangler": "4.124.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "glob": "13.0.6",
    "qs": "6.15.3",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.14.10": true,
    "workerd@1.20260815.1": true
  }
}
