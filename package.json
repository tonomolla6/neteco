{
  "name": "neteco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:recovery": "vitest run --project integration tests/integration/provider-recovery.test.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:browser-matrix": "tsx scripts/run-e2e.ts --config=playwright.matrix.config.ts",
    "test:visual": "tsx scripts/run-e2e.ts --config=playwright.visual.config.ts",
    "test:a11y": "npm run test:e2e -- --project=chromium --workers=2 tests/e2e/accessibility.spec.ts",
    "test:performance": "tsx scripts/run-performance.ts",
    "audit:a11y:manual": "tsx scripts/audit-manual-accessibility-evidence.ts",
    "test:contract:redsys:sandbox": "tsx scripts/redsys-sandbox-contract.ts",
    "test:contract:beply:sandbox": "tsx scripts/beply-sandbox-contract.ts",
    "test:determinism": "tsx scripts/audit-test-determinism.ts --publish",
    "test:mutation": "stryker run",
    "coverage:policy": "tsx scripts/audit-coverage-policy.ts",
    "coverage": "npm run coverage:policy && vitest run --coverage --project unit && npm run coverage:policy -- --publish",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:determinism && npm run coverage && npm run build",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "outbox:email": "tsx scripts/outbox-worker.ts",
    "outbox:invoice": "tsx scripts/invoice-worker.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "reconcile:bank-transfers": "tsx scripts/bank-transfer-reconcile.ts",
    "expire:reservations": "tsx scripts/reservation-worker.ts",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "outbox:refund": "tsx scripts/refund-worker.ts",
    "outbox:credit": "tsx scripts/credit-note-worker.ts",
    "alerts:check": "tsx scripts/operational-alerts.ts",
    "synthetic:check": "tsx scripts/synthetic-check.ts",
    "catalog:release": "tsx scripts/catalog-release.ts",
    "requirements:audit": "tsx scripts/audit-master-requirements.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "^4.0.0",
    "@pinia/nuxt": "^0.11.2",
    "ioredis": "6.0.0",
    "nodemailer": "9.0.5",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.20",
    "otpauth": "9.5.1",
    "pinia": "^3.0.3",
    "postgres": "3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/nodemailer": "8.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.2",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "^5.6.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "glob": "13.0.6",
    "qs": "6.15.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "vue-demi@0.14.10": true
  }
}
